# Database (elige UNA forma)

# Opción A — URL completa
# Formato: postgresql://USUARIO:CONTRASEÑA@localhost:5432/NOMBRE_BD
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/seguimiento

# Opción B — variables separadas (si no usas DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=TU_PASSWORD
# DB_NAME=seguimiento
# DB_SCHEMA=public

# API
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
COOKIE_SECURE=false

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Seed
SEED_ADMIN_EMAIL=admin@sena.edu.co
SEED_ADMIN_PASSWORD=Admin123!
SEED_INSTRUCTOR_EMAIL=instructor@sena.edu.co
SEED_INSTRUCTOR_PASSWORD=Instructor123!

# Reportes PDF (opcional)
# REPORT_LOGO_PATH=./assets/logo-sena.png
